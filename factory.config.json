{
  "model": {
    "id": "gpt-6.1-sol",
    "baseUrl": "http://127.0.0.1:8317/v1",
    "api": "responses",
    "reasoningEffort": "medium",
    "apiKeyEnv": "DARKFACTORY_API_KEY"
  },
  "router": {
    "managed": true,
    "command": "cliproxyapi",
    "args": ["-config", "config/router.yaml"]
  },
  "observer": {
    "enabled": true,
    "intervalMs": 15000,
    "timeoutMs": 10000
  },
  "sandbox": {
    "isolation": "none"
  },
  "figma": {
    "tokenEnv": "FIGMA_ACCESS_TOKEN",
    "auth": "personal"
  }
}

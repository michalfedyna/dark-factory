{
  "model": {
    "id": "gpt-6.1-sol",
    "baseUrl": "http://127.0.0.1:8317/v1",
    "api": "responses",
    "apiKeyEnv": "DARKFACTORY_API_KEY",
    "maxSteps": 30
  },
  "router": {
    "managed": true,
    "command": "cliproxyapi",
    "args": ["-config", "config/router.yaml"],
    "readyTimeoutMs": 20000
  },
  "observer": {
    "enabled": true,
    "intervalMs": 15000,
    "timeoutMs": 10000
  },
  "sessionTimeoutMs": 1800000
}

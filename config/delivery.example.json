{
  "delivery": {
    "repository": "../your-app",
    "baseBranch": "main",
    "githubRepo": "your-org/your-app",
    "trustedLocalExecution": true,
    "isolation": "native",
    "allowNetwork": true,
    "allowedPaths": ["src", "test"],
    "setup": [{ "command": "npm", "args": ["ci"] }],
    "checks": [
      { "id": "test", "command": "npm", "args": ["test", "--", "--run"] },
      { "id": "build", "command": "npm", "args": ["run", "build"] }
    ],
    "targets": [
      {
        "id": "web",
        "kind": "web",
        "url": "http://127.0.0.1:3000",
        "start": {
          "command": "npm",
          "args": [
            "run",
            "dev",
            "--",
            "--host",
            "127.0.0.1",
            "--port",
            "3000",
            "--strictPort"
          ]
        },
        "screenshots": true
      }
    ],
    "maxRepairRounds": 3,
    "timeoutMs": 3600000
  }
}
